	)
	(text "NOTES\n \nGND isolated from p-coil and s-coil \nK1 is a statement for a fake transformer, acting like a coupled inductor  \nCin filters incoming ripple \nCout reduces output ripple \nR1-R2 divider based on datasheet suggestions \nRsnub, Csnub, Dsnub represent a RCD clamp \nT ratio = 4 \nD1 is rev-biased when LT8300 MOSFET is ON, FW-biased when OFF\nFB resistor R3 based on datasheet suggestions\nSimulation Mode: Transient Simulation with 10ms with startup\nDsnub and D1 are rated to ~ 100Vbr \n0.995 in the K-statement represents true tranformer leakage inductance\nAdditional EMI inductor added in series to p-coil for board SW node parasitics\n\nNC = Not Connected \nTPs added to probe oscilloscope signals \nTransient Simulation Completed Fully in LTspice"
		(exclude_from_sim no)
		(at 189.23 15.494 0)
		(effects
			(font
				(face "Arial")
				(size 1.905 1.905)
			)
			(justify left top)
		)
		(uuid "92e2120a-6c46-49dc-8253-e393a027b70a")
	)
